HOST=127.0.0.1
PORT=3001
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_TOKEN=replace-with-a-random-token-at-least-32-characters
CATALOG_PATH=examples/catalog.demo.json
# Exact socket peer IPs allowed to use /compat/vod WITHOUT a token.
# Keep empty to require Bearer auth everywhere. Never trust a shared reverse proxy IP.
COMPAT_ALLOWED_IPS=
REQUESTS_PER_MINUTE=120
